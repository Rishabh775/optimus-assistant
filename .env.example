OPENCODE_API_KEY=
# 3B runs ~15-20 tok/s on a 4-core CPU; 7B models are too slow (~5 tok/s)
JARVIS_LOCAL_MODEL=llama3.2:3b
# Free + unlimited on Go while it lasts; fallback: mimo-v2.6-flash (cheapest paid)
JARVIS_CLOUD_MODEL=longcat-2.5-preview-free
# If the cloud model fails (free previews can vanish), retry once with this:
JARVIS_CLOUD_FALLBACK=mimo-v2.6-flash
JARVIS_CODE_MODEL=kimi-k2.7-code
JARVIS_WHISPER_MODEL=base
JARVIS_COMMAND_MODEL=tiny.en
JARVIS_DATA_DIR=/home/rishabhs/jarvis/data
JARVIS_HOTKEY=ctrl+alt+j
# Wake word: "hey soundwave" (custom-trained verifier with adversarial negatives).
# debounce MUST be 1: the sharper model peaks on a single 1.2s chunk (2 never fires).
# Threshold 0.7 = high recall; raise toward 0.85 if you get false wakes.
JARVIS_WAKE_WORDS=hey_soundwave
JARVIS_NAME=Optimus
JARVIS_TTS_VOICE=en-US-AndrewMultilingualNeural
JARVIS_WAKE_WHISPER_MODEL=tiny.en
JARVIS_WAKE_THRESHOLD=0.7
JARVIS_WAKE_CHUNK_MS=1200
JARVIS_WAKE_ENERGY_MIN=1000
JARVIS_WAKE_DEBOUNCE=1
JARVIS_WAKE_ENERGY_MIN_INTERRUPT=1500
JARVIS_LOCAL_OK=0

# Audible feedback: chirp on wake-word detection + tone after speech captured
JARVIS_SOUNDS=1

# Continued conversation: after an answer, mic stays open this many seconds
# for follow-ups (same context). Silence or a stop phrase ("thanks", "stop",
# "that's all") ends it. Set JARVIS_FOLLOWUP=0 to disable.
JARVIS_FOLLOWUP=1
JARVIS_FOLLOWUP_SECONDS=6

# Spoken greeting on wake ("What's up, boss?"). Custom pool uses | separator:
#   JARVIS_GREETINGS=What's up, boss?|Ready, chief|Go ahead
# Note: greeting plays BEFORE the mic opens, keep phrases short. 0 disables.
JARVIS_GREET=1

# Press Enter during TTS to interrupt the reply (kills all queued chunks).
# OFF by default: stray Enter keystrokes in a TTY terminal kill mid-sentence
# speech. Turn on if you want explicit barge-in.
JARVIS_BARGE_IN=0

# Tool budget per question: complex browser/system questions can take 8-10
# tool calls. If the agent runs out it summarizes what it found instead of
# giving up.
JARVIS_MAX_STEPS=12

# LLM reliability (timeout seconds / retries on network blips)
JARVIS_LLM_TIMEOUT=60
JARVIS_LLM_RETRIES=2
# Circuit breaker: after the primary cloud model fails, route straight to the
# fallback for this many seconds (avoids a full timeout on every call).
JARVIS_CLOUD_COOLDOWN=90

# STT (faster-whisper, int8 on CPU)
JARVIS_STT_COMPUTE=int8
JARVIS_STT_THREADS=4
# Confidence gate: reject silence/noise transcripts. A transcript is dropped
# only when BOTH look bad (no_speech_prob > MAX and avg_logprob < MIN).
JARVIS_STT_MAX_NO_SPEECH=0.6
JARVIS_STT_MIN_LOGPROB=-1.0
# Mid-speech pause (ms) tolerated before deciding you finished talking.
# 2200 is generous - raise further if you still get cut off mid-sentence;
# lower for snappier replies.
JARVIS_STT_END_SILENCE=1800
# Mic gate sensitivity (PEAK amplitude, same scale as the wake detector):
# speech must exceed ambient noise x this multiplier (floor 400).
# 1.0 = soft speech stays "voiced"; raise toward 1.5 if it picks up background.
JARVIS_STT_ENERGY_MULT=1.0
# Hard ceiling on the calibrated gate. Ambient is the MEDIAN peak of several
# windows (robust to transients) and the gate never exceeds this - so a loud
# calibration moment (e.g. speaker bleed) can't make the assistant deaf.
JARVIS_STT_GATE_MAX=6000
# Silence after TTS stops before sampling/calibrating (speaker tail margin).
JARVIS_STT_TAIL=0.35
# Software input gain for quiet built-in mics (1.0 = off, try 2-4 if laptop
# mic is too quiet). Applied to the energy gates only; STT + wake classifier
# still see the raw audio.
JARVIS_MIC_GAIN=1.0

# Memory hygiene (max cosine distance to count as relevant; retention cap)
JARVIS_MEMORY_MAX_DIST=0.55
JARVIS_MEMORY_MAX_ENTRIES=500
# Durable user facts (remember_fact/recall_facts) stored in data/facts.jsonl
JARVIS_FACTS_MAX=100

# Security: lift read/write path restrictions (not recommended)
JARVIS_ALLOW_ANY_PATH=0
# Confirmation gate: ask before consequential actions (risky shell,
# sending email, overwriting a file). 0 disables.
JARVIS_CONFIRM=1
# Logging: JARVIS_LOG_LEVEL=DEBUG for verbose; format defaults to just
# the message (unchanged console output).
JARVIS_LOG_LEVEL=INFO

# Home Assistant
JARVIS_HA_URL=
JARVIS_HA_TOKEN=

# Email (IMAP/SMTP)
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASS=
JARVIS_EMAIL_IMAP=imap.gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_SMTP_PORT=587

# Email triage (deterministic importance ranking used by email_triage)
# Any of these substrings in the From address -> always HIGH
JARVIS_EMAIL_VIP_SENDERS=
# Keywords that raise importance (+20 each); comma-separated
JARVIS_EMAIL_PRIORITY_KEYWORDS=invoice,payment,urgent,asap,deadline,action required,verify,security,alert,expir,interview,offer,contract,overdue
# Keywords that lower importance (-25 each); comma-separated
JARVIS_EMAIL_LOW_KEYWORDS=newsletter,unsubscribe,promo,sale,discount,marketing,no-reply,noreply

# Calendar (CalDAV - works with iCloud, Nextcloud, Fastmail)
JARVIS_CALDAV_URL=
JARVIS_CALDAV_USER=
JARVIS_CALDAV_PASS=
JARVIS_CALDAV_CALENDAR=