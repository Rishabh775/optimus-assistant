OPENCODE_API_KEY=
# 3B runs ~15-20 tok/s on a 4-core CPU; 7B models are too slow (~5 tok/s)
JARVIS_LOCAL_MODEL=llama3.2:3b
# Included in the Go plan; fallback: mimo-v2.6-flash (cheapest paid)
JARVIS_CLOUD_MODEL=glm-5.3-flash
# If the cloud model fails (free previews can vanish), retry once with this:
JARVIS_CLOUD_FALLBACK=deepseek-v4-flash
JARVIS_CODE_MODEL=kimi-k2.7-code
JARVIS_WHISPER_MODEL=small.en
JARVIS_COMMAND_MODEL=small.en
JARVIS_DATA_DIR=/home/rishabhs/jarvis/data
JARVIS_HOTKEY=ctrl+alt+j
# Wake word: "hey soundwave" (custom-trained verifier with adversarial negatives).
# debounce MUST be 1: the sharper model peaks on a single 1.2s chunk (2 never fires).
# Threshold 0.7 = high recall; raise toward 0.85 if you get false wakes.
JARVIS_WAKE_WORDS=hey_soundwave
JARVIS_NAME=Optimus
JARVIS_TTS_VOICE=en-US-AndrewMultilingualNeural
# Offline TTS fallback: if edge-tts (cloud) fails -- e.g. Microsoft rotates
# its auth token and old clients get HTTP 403 -- speak via local Piper instead
# of going silent. Set "off" to disable.
JARVIS_TTS_FALLBACK=piper
# VOICE PACK: DSP effect applied over the neural voice with ffmpeg.
# soundwave = deep monotone radio voice (Transformers); robot = harsher;
# deep = slow deep narrator; off = unprocessed natural voice.
JARVIS_TTS_EFFECT=off

# PERSONALITY: soundwave (cold Decepticon comms officer) | jarvis (British
# butler) | glados (dry corporate menace) | off (neutral). Any other text is
# used verbatim as a personality hint in the system prompt.
JARVIS_PERSONALITY=off
# Piper .onnx voice. Empty = first model found in $JARVIS_DATA_DIR/piper/.
JARVIS_PIPER_MODEL=
JARVIS_WAKE_WHISPER_MODEL=tiny.en
JARVIS_WAKE_THRESHOLD=0.7
JARVIS_WAKE_CHUNK_MS=1200
JARVIS_WAKE_ENERGY_MIN=1000
JARVIS_WAKE_DEBOUNCE=1
JARVIS_WAKE_ENERGY_MIN_INTERRUPT=1500
JARVIS_LOCAL_OK=0

# Audible feedback: chirp on wake-word detection + tone after speech captured
JARVIS_SOUNDS=1

# Continued conversation: after an answer, mic stays open this many seconds
# for follow-ups (same context). Silence or a stop phrase ("thanks", "stop",
# "that's all") ends it. Set JARVIS_FOLLOWUP=0 to disable.
JARVIS_FOLLOWUP=1
JARVIS_FOLLOWUP_SECONDS=6

# Spoken greeting on wake ("What's up, boss?"). Custom pool uses | separator:
#   JARVIS_GREETINGS=What's up, boss?|Ready, chief|Go ahead
# Note: greeting plays BEFORE the mic opens, keep phrases short. 0 disables.
JARVIS_GREET=1

# Press Enter during TTS to interrupt the reply (kills all queued chunks).
# ON by default and applied to every speaking path (voice/wake/hotkey).
# Set 0 to disable (a stray Enter in a TTY terminal would otherwise cut
# mid-sentence speech).
JARVIS_BARGE_IN=1

# Tool budget per question: complex browser/system questions can take 8-10
# tool calls. If the agent runs out it summarizes what it found instead of
# giving up.
JARVIS_MAX_STEPS=12

# LLM reliability (timeout seconds / retries on network blips)
JARVIS_LLM_TIMEOUT=60
JARVIS_LLM_RETRIES=2
# Circuit breaker: after the primary cloud model fails, route straight to the
# fallback for this many seconds (avoids a full timeout on every call).
JARVIS_CLOUD_COOLDOWN=90

# STT (faster-whisper, int8 on CPU)
JARVIS_STT_COMPUTE=int8
JARVIS_STT_THREADS=4
# Language lock: skip auto-detect (fewer mis-detections, slightly faster).
# Empty = auto-detect.
JARVIS_STT_LANGUAGE=en
# Beam search width for decoding. 1 = greedy (fastest); 5 = more accurate.
JARVIS_STT_BEAM_SIZE=5
# Bias recognition toward words you actually say (names, tech terms, paths).
# faster-whisper only; keep short.
JARVIS_STT_INITIAL_PROMPT=Voice commands to a local assistant about files, folders, HTML, CSS, JavaScript, DOM manipulation, workspace, email, calendar.
JARVIS_STT_HOTWORDS=DOM manipulation HTML CSS JavaScript workspace
# Confidence gate: reject silence/noise transcripts. A transcript is dropped
# only when BOTH look bad (no_speech_prob > MAX and avg_logprob < MIN).
JARVIS_STT_MAX_NO_SPEECH=0.6
JARVIS_STT_MIN_LOGPROB=-1.0
# Mid-speech pause (ms) tolerated before deciding you finished talking.
# 2200 is generous - raise further if you still get cut off mid-sentence;
# lower for snappier replies.
JARVIS_STT_END_SILENCE=1800
# Mic gate sensitivity (PEAK amplitude, same scale as the wake detector):
# speech must exceed ambient noise x this multiplier (floor 400).
# 1.0 = soft speech stays "voiced"; raise toward 1.5 if it picks up background.
JARVIS_STT_ENERGY_MULT=1.0
# Hard ceiling on the calibrated gate. Ambient is the MEDIAN peak of several
# windows (robust to transients) and the gate never exceeds this. Must sit
# ABOVE real ambient: if ambient >= this, the gate can't rise above the noise
# floor and the mic false-triggers. Raise for noisy rooms.
JARVIS_STT_GATE_MAX=15000
# End-of-speech uses hysteresis: a higher gate to START, then capture ends
# only when audio drops well below YOUR speech level (ref x STOP_RATIO).
# Raise STOP_RATIO if it still cuts you off mid-sentence.
JARVIS_STT_STOP_RATIO=0.35
JARVIS_STT_STOP_FLOOR=120
JARVIS_STT_MIN_SPEECH=0.5
# Silence after TTS stops before sampling/calibrating (speaker tail margin).
JARVIS_STT_TAIL=0.35
# Software input gain for quiet built-in mics (1.0 = off, try 2-4 if laptop
# mic is too quiet). Applied to the energy gates only; STT + wake classifier
# still see the raw audio.
JARVIS_MIC_GAIN=1.0

# Memory hygiene (max cosine distance to count as relevant; retention cap)
JARVIS_MEMORY_MAX_DIST=0.55
JARVIS_MEMORY_MAX_ENTRIES=500
# Durable user facts (remember_fact/recall_facts) stored in data/facts.jsonl
JARVIS_FACTS_MAX=100

# Security: lift read path restrictions (not recommended)
JARVIS_ALLOW_ANY_PATH=0
# Allow writes anywhere under $HOME (outside workspace/). These are ALWAYS
# gated by a mandatory confirmation prompt and refused when no prompt is
# possible (e.g. --query). Set 0 for the old workspace-only write sandbox.
JARVIS_ALLOW_HOME_WRITES=1
# Confirmation gate: ask before consequential actions (risky shell,
# sending email, overwriting a file). 0 disables. Note: writes outside
# workspace/ stay gated even when this is 0.
JARVIS_CONFIRM=1
# AUTO MODE: never ask for confirmation on anything (including mandatory
# home-folder writes and risky shell). Hard safety blocks (destructive
# command blocklist, secret-file reads) still apply. Use only on a
# trusted setup. 1 = auto mode.
JARVIS_AUTO=0
# Logging: JARVIS_LOG_LEVEL=DEBUG for verbose; format defaults to just
# the message (unchanged console output).
JARVIS_LOG_LEVEL=INFO

# Home Assistant
JARVIS_HA_URL=
JARVIS_HA_TOKEN=

# Email (IMAP/SMTP)
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASS=
JARVIS_EMAIL_IMAP=imap.gmail.com
JARVIS_EMAIL_SMTP=smtp.gmail.com
JARVIS_EMAIL_SMTP_PORT=587

# Email triage (deterministic importance ranking used by email_triage)
# Any of these substrings in the From address -> always HIGH
JARVIS_EMAIL_VIP_SENDERS=
# Keywords that raise importance (+20 each); comma-separated
JARVIS_EMAIL_PRIORITY_KEYWORDS=invoice,payment,urgent,asap,deadline,action required,verify,security,alert,expir,interview,offer,contract,overdue
# Keywords that lower importance (-25 each); comma-separated
JARVIS_EMAIL_LOW_KEYWORDS=newsletter,unsubscribe,promo,sale,discount,marketing,no-reply,noreply

# Calendar (CalDAV - works with iCloud, Nextcloud, Fastmail)
JARVIS_CALDAV_URL=
JARVIS_CALDAV_USER=
JARVIS_CALDAV_PASS=
JARVIS_CALDAV_CALENDAR=
# Phone app server (python -m jarvis.server)
# Token is auto-generated into .env on first start if empty.
# Requires a token on every request; connect over Tailscale (recommended)
# or LAN WiFi (http://<pc-ip>:8080).
JARVIS_APP_TOKEN=
JARVIS_APP_HOST=0.0.0.0
JARVIS_APP_PORT=8080
JARVIS_APP_CONFIRM_TIMEOUT=120
# Phone uploads (photos/documents/voice notes) saved here; max size in MB
JARVIS_APP_UPLOAD_DIR=data/phone-app/uploads
JARVIS_APP_UPLOAD_MAX_MB=25

# Reminders (proactive loop): durable, notify-only. Fires whether you are
# running text/voice/wake mode or the phone-app server; SQLite-backed so
# they survive reboots (startup catch-up fires past-due ones as "(missed)").
# Timezone for reminder/briefing times; empty = system local.
JARVIS_REMINDER_DB=data/phone-app/reminders.db
JARVIS_SCHED_TICK=20
JARVIS_TZ=
# Phone push for fired reminders (both required to enable). Install the
# ntfy app on the phone and subscribe to the same topic.
# Start on the public server, or self-host: JARVIS_NTFY_URL=http://<ts-ip>:2580
JARVIS_NTFY_URL=
JARVIS_NTFY_TOPIC=
# Optional Bearer token (self-hosted ntfy with auth)
JARVIS_NTFY_TOKEN=
# Daily briefing ("07:30" local). Sections auto-skip what is not configured.
JARVIS_BRIEFING_TIME=
# Weather (Open-Meteo, no API key): home location for forecasts
JARVIS_LAT=
JARVIS_LON=
# Or a city name instead of coords (extra geocoding hop)
JARVIS_WEATHER_CITY=

# Jobs skill (discovery + tracker; applying is a later phase)
JARVIS_JOBS_ENABLED=0
JARVIS_JOBS_SWEEP_TIME=08:30
JARVIS_JOBS_DIGEST_SIZE=10
JARVIS_JOBS_MIN_SCORE=25
JARVIS_JOBS_MAX_AGE_DAYS=21
# any = show every remote role (region-restricted ones are labeled)
# eligible = hide roles restricted to other regions
JARVIS_JOBS_REMOTE_SCOPE=any
# fast alerts: poll every N minutes and push new roles immediately
JARVIS_JOBS_ALERTS=1
JARVIS_JOBS_ALERT_INTERVAL_MIN=15
JARVIS_JOBS_ALERT_MIN_SCORE=45
JARVIS_JOBS_ALERT_MAX_PER_RUN=4
# aggregator feeds have no ETag -> refresh hourly (ATS boards poll often)
JARVIS_JOBS_FEEDS_INTERVAL_MIN=60
# 1 = hide remote roles whose posting never states an eligible region
JARVIS_JOBS_HIDE_UNCLEAR_REMOTE=0
JARVIS_JOBS_COUNTRY=in
# public ATS boards, provider:company (Greenhouse/Lever/Ashby)
JARVIS_JOBS_BOARDS=greenhouse:stripe,greenhouse:canonical,ashby:linear,ashby:supabase
# optional Adzuna search API (free key at developer.adzuna.com) for India-wide search
JARVIS_ADZUNA_APP_ID=
JARVIS_ADZUNA_APP_KEY=
# free tier is 250/day -> poll Adzuna at most hourly
JARVIS_ADZUNA_MIN_INTERVAL_MIN=60
